<?xml version="1.0" encoding="UTF-8"?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.chatsystem.user.controller.group.CreateGroupDialogController"
 spacing="10" styleClass="dialog-content" prefWidth="530" prefHeight="515">
 <Label text="Create group" styleClass="page-title"/>
 <TextField fx:id="groupNameField" promptText="Group name"/>
 <TextArea fx:id="descriptionField" promptText="Description (optional)" prefRowCount="2"/>
 <Label text="Choose at least one initial member (by full name or username)" styleClass="form-label" wrapText="true"/>
 <TextField fx:id="memberSearchField" promptText="Search for a member or @username"/>
 <ListView fx:id="memberList" prefHeight="140" VBox.vgrow="ALWAYS"/>
 <Label fx:id="chosenMembersLabel" text="No members selected" styleClass="muted" wrapText="true"/>
 <Label fx:id="feedbackLabel" wrapText="true"/>
 <HBox spacing="8"><Button text="Cancel" onAction="#cancel"/>
   <Button fx:id="submitCreateGroupButton" text="Create group &amp; invite" onAction="#submit" styleClass="primary-button"/></HBox>
</VBox>
