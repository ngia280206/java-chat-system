<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>
<VBox xmlns:fx="http://javafx.com/fxml/1" styleClass="content-wrap" spacing="22" fx:controller="com.chatsystem.user.controller.account.ChangePasswordController">
  <Label text="RELAY  /  CHANGE PASSWORD" styleClass="breadcrumb" />
  <HBox spacing="12" alignment="CENTER_LEFT">
    <VBox spacing="5" HBox.hgrow="ALWAYS">
      <Label text="Change password" styleClass="page-title" />
      <Label text="Keep your account protected with a strong password." styleClass="page-subtitle" />
    </VBox>
    <Button text="Back to settings" styleClass="secondary-button" onAction="#back" />
  </HBox>
  <VBox spacing="14" styleClass="card">
    <Label text="Update your password" styleClass="section-title" />
    <VBox spacing="14">
      <Label text="Current password" styleClass="form-label" />
      <PasswordField fx:id="currentPasswordField" promptText="Current password" />
    </VBox>
    <VBox spacing="14">
      <Label text="New password" styleClass="form-label" />
      <PasswordField fx:id="newPasswordField" promptText="New password" />
    </VBox>
    <VBox spacing="14">
      <Label text="Confirm password" styleClass="form-label" />
      <PasswordField fx:id="confirmPasswordField" promptText="Confirm password" />
    </VBox>
    <Label text="Use at least 8 characters and avoid reusing a previous password." styleClass="form-hint" />
    <HBox spacing="12" alignment="CENTER_LEFT">
      <Button text="Cancel" styleClass="secondary-button" onAction="#back" />
      <Button text="Update password" styleClass="primary-button" fx:id="updatePasswordButton" onAction="#update" />
    </HBox>
    <Label fx:id="accountFeedbackLabel" />
  </VBox>
</VBox>
