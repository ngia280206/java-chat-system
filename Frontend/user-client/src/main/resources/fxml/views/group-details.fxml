<?xml version="1.0" encoding="UTF-8"?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?><VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.chatsystem.user.controller.group.GroupDetailsController" spacing="10" styleClass="app-root"><HBox spacing="8"><Button text="← Back to groups" onAction="#back"/><Label text="Group details" styleClass="page-title"/><Button fx:id="inviteMemberButton" text="Invite members" onAction="#invite"/><Button fx:id="leaveGroupButton" text="Leave Group" onAction="#leave"/></HBox><TextField fx:id="nameField" promptText="Group name"/><TextArea fx:id="descriptionField" promptText="Group description"/><Button fx:id="saveGroupButton" text="Save changes" onAction="#save"/><ListView fx:id="memberList" VBox.vgrow="ALWAYS"/><HBox spacing="8"><ChoiceBox fx:id="roleChoice"/><Button fx:id="changeRoleButton" text="Change Group Role" onAction="#changeRole"/><Button fx:id="removeMemberButton" text="Remove member" onAction="#remove"/></HBox><HBox fx:id="groupConfirmationBar" managed="false" visible="false" spacing="8"><Label text="Confirm this group action?"/><Button fx:id="confirmGroupActionButton" text="Confirm" onAction="#confirmAction"/><Button fx:id="cancelGroupActionButton" text="Cancel" onAction="#cancelAction"/></HBox><Label fx:id="groupFeedbackLabel"/></VBox>
