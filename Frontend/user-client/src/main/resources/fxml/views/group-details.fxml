<?xml version="1.0" encoding="UTF-8"?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.chatsystem.user.controller.group.GroupDetailsController" spacing="12" styleClass="content-wrap"><HBox spacing="8"><Button text="← Back to groups" onAction="#back"/><Label text="Group details" styleClass="page-title" HBox.hgrow="ALWAYS"/><Button text="Edit group" onAction="#edit"/><Button fx:id="inviteMemberButton" text="Invite members" onAction="#invite"/><Button fx:id="leaveGroupButton" text="Leave Group" onAction="#leave"/></HBox><HBox spacing="15" VBox.vgrow="ALWAYS"><VBox spacing="10" styleClass="card" HBox.hgrow="ALWAYS"><Label text="Group information" styleClass="section-title"/><Label text="Group name" styleClass="form-label"/><TextField fx:id="nameField" promptText="Group name"/><Label text="Group description" styleClass="form-label"/><TextArea fx:id="descriptionField" promptText="Group description" prefRowCount="4"/><Button fx:id="saveGroupButton" text="Save changes" onAction="#save" styleClass="primary-button"/></VBox><VBox spacing="10" styleClass="card" HBox.hgrow="ALWAYS"><Label text="Members and roles" styleClass="section-title"/><HBox spacing="8"><Label text="MEMBER" styleClass="table-heading" HBox.hgrow="ALWAYS"/><Label text="ROLE / ACTION" styleClass="table-heading"/></HBox><ListView fx:id="memberList" VBox.vgrow="ALWAYS"/></VBox></HBox><HBox fx:id="groupConfirmationBar" managed="false" visible="false" spacing="8"><Label fx:id="groupConfirmationLabel"/><Button fx:id="confirmGroupActionButton" text="Confirm" onAction="#confirmAction"/><Button fx:id="cancelGroupActionButton" text="Cancel" onAction="#cancelAction"/></HBox><Label fx:id="groupFeedbackLabel"/></VBox>
