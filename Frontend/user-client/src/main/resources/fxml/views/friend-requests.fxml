<?xml version="1.0" encoding="UTF-8"?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?><VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.chatsystem.user.controller.social.FriendRequestsController" spacing="10" styleClass="app-root"><HBox spacing="8"><Button text="← Back to friends" onAction="#back"/><Label text="Friend requests" styleClass="page-title"/></HBox><TextField fx:id="requestSearchField" promptText="Filter incoming and sent requests by name"/><Label text="Incoming" styleClass="section-title"/><ListView fx:id="incomingList" VBox.vgrow="ALWAYS"/><HBox spacing="8"><Button fx:id="acceptButton" text="Accept" onAction="#accept"/><Button fx:id="declineButton" text="Decline" onAction="#decline"/></HBox><Label text="Sent" styleClass="section-title"/><ListView fx:id="outgoingList" VBox.vgrow="ALWAYS"/><Button fx:id="cancelRequestButton" text="Cancel request" onAction="#requestCancel"/><HBox fx:id="requestConfirmationBar" managed="false" visible="false" spacing="8"><Label text="Cancel this sent request?"/><Button fx:id="confirmRequestButton" text="Confirm" onAction="#confirmCancel"/><Button fx:id="cancelRequestDecisionButton" text="Keep request" onAction="#cancelDecision"/></HBox><Label fx:id="requestFeedbackLabel"/></VBox>
