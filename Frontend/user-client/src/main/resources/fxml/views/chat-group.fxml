<?xml version="1.0" encoding="UTF-8"?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.chatsystem.user.controller.chat.ChatGroupController" styleClass="app-root" prefWidth="1250" prefHeight="850"><top><HBox spacing="10" styleClass="page-header"><Button text="← Chats" onAction="#back"/><Label fx:id="conversationTitle" styleClass="page-title" HBox.hgrow="ALWAYS"/><Button text="+ New" onAction="#newConversation"/><Button fx:id="searchButton" text="Search" onAction="#search"/><Button fx:id="assistantButton" text="✦ Ask AI" onAction="#assistant"/><Button text="Manage group" onAction="#groupDetails"/><Button fx:id="clearHistoryButton" text="Clear History" onAction="#clearHistory"/></HBox></top><center><HBox><VBox styleClass="conversation-pane" prefWidth="300"><Label text="Messages" styleClass="section-title"/><TextField promptText="Search conversations" styleClass="search-field"/><HBox spacing="8"><Label text="All" styleClass="pill-active"/><Label text="Unread" styleClass="pill"/><Label text="Groups" styleClass="pill"/></HBox><ListView fx:id="conversationList" VBox.vgrow="ALWAYS"/></VBox><ListView fx:id="messageList" styleClass="chat-main" HBox.hgrow="ALWAYS"/><VBox styleClass="chat-rail" prefWidth="210"><Label text="Group members" styleClass="section-title"/><Label text="Member roles and availability are managed in Group details." wrapText="true"/></VBox></HBox></center><bottom><VBox spacing="8"><HBox fx:id="confirmationBar" visible="false" managed="false" spacing="8"><Label fx:id="confirmationLabel"/><Button fx:id="confirmActionButton" text="Confirm" onAction="#confirmAction"/><Button fx:id="cancelActionButton" text="Cancel" onAction="#cancelAction"/></HBox><Label fx:id="feedbackLabel"/><HBox spacing="8" styleClass="chat-composer"><StackPane fx:id="attachmentWrapper"><Button fx:id="attachmentButton" text="+"/></StackPane><TextField fx:id="messageField" promptText="Write a message..." HBox.hgrow="ALWAYS"/><Button fx:id="sendButton" text="Send →" onAction="#send" styleClass="primary-button"/><Button fx:id="hideMessageButton" text="Hide Message" onAction="#hideSelected"/></HBox></VBox></bottom></BorderPane>
