<?xml version="1.0" encoding="UTF-8"?><?import javafx.scene.control.*?><?import javafx.scene.layout.*?><VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.chatsystem.user.controller.account.SettingsController" spacing="10" styleClass="app-root"><Label text="Settings" styleClass="page-title"/><HBox spacing="8"><Button text="Dark"/><StackPane fx:id="lightThemeWrapper"><Button fx:id="lightThemeButton" text="Light"/></StackPane><StackPane fx:id="systemThemeWrapper"><Button fx:id="systemThemeButton" text="System"/></StackPane></HBox><CheckBox fx:id="notificationCheckBox" text="Enable desktop notifications"/><CheckBox fx:id="soundCheckBox" text="Play a sound for new messages"/><CheckBox fx:id="previewCheckBox" text="Show message previews"/><Button fx:id="savePreferencesButton" text="Save preferences" onAction="#save"/><VBox spacing="5" styleClass="card"><Label text="Privacy" styleClass="section-title"/><Label fx:id="privacySummaryLabel" text="Profile visibility and blocked-account controls are managed locally in this demo." wrapText="true"/><Label text="Security" styleClass="section-title"/><Label fx:id="securitySummaryLabel" text="Password changes affect only this in-memory session; no cryptography or device keys are used." wrapText="true"/></VBox><HBox spacing="8"><Button fx:id="changePasswordButton" text="Change password" onAction="#password"/><Button fx:id="blockedAccountsButton" text="Blocked accounts" onAction="#blocked"/><Button fx:id="signOutButton" text="Sign out" onAction="#logout"/></HBox><Label fx:id="accountFeedbackLabel"/></VBox>
