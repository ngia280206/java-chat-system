<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>
<VBox xmlns:fx="http://javafx.com/fxml/1" styleClass="content-wrap" spacing="22" fx:controller="com.chatsystem.user.controller.account.SettingsController">
  <Label text="RELAY  /  SETTINGS" styleClass="breadcrumb" />
  <HBox spacing="12" alignment="CENTER_LEFT">
    <VBox spacing="5" HBox.hgrow="ALWAYS">
      <Label text="Settings" styleClass="page-title" />
      <Label text="Personalize your Relay experience and account security." styleClass="page-subtitle" />
    </VBox>
    <Button text="Save preferences" styleClass="primary-button" fx:id="savePreferencesButton" onAction="#save" />
  </HBox>
  <HBox spacing="12" alignment="TOP_LEFT">
    <VBox spacing="14" styleClass="card" HBox.hgrow="ALWAYS" prefWidth="0">
      <Label text="Appearance &amp; notifications" styleClass="section-title" />
      <HBox spacing="12" alignment="CENTER_LEFT">
        <Label text="Theme" styleClass="muted" />
        <Region HBox.hgrow="ALWAYS" />
        <Label text="Dark mode" styleClass="body-text" />
      </HBox>
      <HBox spacing="12" alignment="CENTER_LEFT">
        <Button text="Dark" styleClass="pill-active" />
        <StackPane fx:id="lightThemeWrapper">
          <Button fx:id="lightThemeButton" text="Light" />
        </StackPane>
        <StackPane fx:id="systemThemeWrapper">
          <Button fx:id="systemThemeButton" text="System" />
        </StackPane>
      </HBox>
      <Separator />
      <CheckBox fx:id="notificationCheckBox" text="Enable desktop notifications" />
      <CheckBox fx:id="soundCheckBox" text="Play a sound for new messages" />
      <CheckBox fx:id="previewCheckBox" text="Show message previews" />
    </VBox>
    <VBox spacing="14" styleClass="card" HBox.hgrow="ALWAYS" prefWidth="0">
      <Label text="Privacy &amp; security" styleClass="section-title" />
      <Label fx:id="privacySummaryLabel" text="Profile visibility and blocked-account controls are managed locally in this demo." wrapText="true" />
      <Label fx:id="securitySummaryLabel" text="Password changes affect only this in-memory session; no cryptography or device keys are used." wrapText="true" />
      <Separator />
      <Button text="Change password" styleClass="secondary-button" fx:id="changePasswordButton" onAction="#password" />
      <Button text="Blocked accounts" styleClass="secondary-button" fx:id="blockedAccountsButton" onAction="#blocked" />
      <Button text="Sign out" styleClass="danger-button" fx:id="signOutButton" onAction="#logout" />
    </VBox>
  </HBox>
  <Label fx:id="accountFeedbackLabel" />
</VBox>
