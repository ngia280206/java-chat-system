<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>
<VBox xmlns:fx="http://javafx.com/fxml/1" styleClass="content-wrap" spacing="22" fx:controller="com.chatsystem.user.controller.report.ReportDetailController">
  <Label text="RELAY  /  REPORT DETAIL" styleClass="breadcrumb" />
  <HBox spacing="12" alignment="CENTER_LEFT">
    <VBox spacing="5" HBox.hgrow="ALWAYS">
      <Label text="Report details" styleClass="page-title" />
      <Label text="Review your report and its current progress." styleClass="page-subtitle" />
    </VBox>
    <Button text="Back to reports" styleClass="secondary-button" fx:id="backToReportsButton" onAction="#back" />
  </HBox>
  <VBox spacing="14" styleClass="card">
    <Label fx:id="reportIdLabel" styleClass="section-title" />
    <Label fx:id="reportStatusLabel" styleClass="pill" />
    <Separator />
    <Label text="Reported account" styleClass="form-label" />
    <Label fx:id="reportTargetLabel" />
    <Label text="Reason" styleClass="form-label" />
    <Label fx:id="reportReasonLabel" wrapText="true" styleClass="body-text" />
    <Separator />
    <Label fx:id="reportProgressLabel" styleClass="section-title" />
    <Label fx:id="reportTimelineLabel" wrapText="true" />
  </VBox>
</VBox>
