<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?><?import javafx.scene.layout.*?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.chatsystem.user.controller.chat.ChatHomeController" styleClass="app-root" prefWidth="1250" prefHeight="850">
 <top><VBox spacing="14" styleClass="page-header"><Label text="Chats" styleClass="page-title"/><HBox spacing="10"><TextField fx:id="conversationSearchField" promptText="Search conversations" HBox.hgrow="ALWAYS"/><Button fx:id="newConversationButton" text="+ New" onAction="#newConversation"/><Button text="Explore groups" onAction="#showGroups"/></HBox><HBox spacing="8"><Button fx:id="allFilterButton" text="All" onAction="#filterAll"/><Button fx:id="unreadFilterButton" text="Unread" onAction="#filterUnread"/><Button fx:id="groupsFilterButton" text="Groups" onAction="#filterGroups"/></HBox></VBox></top>
 <center><ListView fx:id="conversationList" styleClass="card"/></center>
 <bottom><HBox spacing="10" styleClass="card"><Label text="Ready to connect?" styleClass="section-title"/><Button text="Start a conversation" onAction="#newConversation" styleClass="button-primary"/></HBox></bottom>
</BorderPane>
