<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>
<?import java.lang.String?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" styleClass="auth-root" prefWidth="1240" prefHeight="780" fx:controller="com.chatsystem.user.controller.auth.ForgotPasswordController">
  <left>
    <VBox spacing="12" styleClass="auth-brand" prefWidth="570" minWidth="460">
      <HBox spacing="12" alignment="CENTER_LEFT">
        <StackPane styleClass="brand-badge">
          <Label text="R" styleClass="brand-mark"/>
        </StackPane>
        <Label text="RELAY" styleClass="brand-name"/>
      </HBox>
      <Region VBox.vgrow="ALWAYS"/>
      <Label text="Stay close,&#10;even from afar." styleClass="auth-accent" wrapText="true"/>
      <Label text="A calmer space for meaningful conversations." styleClass="auth-caption" wrapText="true"/>
      <Region prefHeight="12"/>
      <Label text="PRIVATE CHATS     /     GROUPS     /     SMART ASSISTANT" styleClass="pill"/>
      <Region prefHeight="58"/>
      <Label text="Beautifully simple. Thoughtfully connected." styleClass="muted"/>
    </VBox>
  </left>
  <center>
    <VBox spacing="12" styleClass="auth-panel" prefWidth="630">
      <Label text="RELAY ACCOUNT" styleClass="sidebar-heading"/>
      <Region prefHeight="4"/>
      <Label text="Forgot your password?" styleClass="auth-title"/>
      <Label text="Enter your email and we will send a verification code." fx:id="feedbackLabel" styleClass="auth-subtitle" wrapText="true"/>
      <Region prefHeight="12"/>
      <VBox spacing="12" styleClass="callout-card">
        <Label text="Account recovery" styleClass="small-heading"/>
        <Label text="We will use your registered email address to verify it is you." styleClass="muted"/>
      </VBox>
      <VBox spacing="7">
        <Label text="Email address" styleClass="form-label"/>
        <TextField fx:id="emailField" promptText="name@example.com" styleClass="text-field" prefWidth="386"/>
      </VBox>
      <Button fx:id="submitButton" onAction="#submit" text="Send verification code  →" styleClass="primary-button" prefWidth="386"/>
      <Region prefHeight="5"/>
      <Button fx:id="backButton" onAction="#back" text="←  Back to sign in" styleClass="inline-link"/>
    </VBox>
  </center>
</BorderPane>
