<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>
<?import java.lang.String?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" styleClass="auth-root" prefWidth="1240" prefHeight="780" fx:controller="com.chatsystem.user.controller.auth.ResetPasswordController">
  <left>
    <VBox spacing="12" styleClass="auth-brand" prefWidth="570" minWidth="460">
      <HBox spacing="12" alignment="CENTER_LEFT">
        <StackPane styleClass="brand-badge">
          <Label text="R" styleClass="brand-mark"/>
        </StackPane>
        <Label text="RELAY" styleClass="brand-name"/>
      </HBox>
      <Region VBox.vgrow="ALWAYS"/>
      <Label text="Stay close,&#10;even from afar." styleClass="auth-accent" wrapText="true"/>
      <Label text="A calmer space for meaningful conversations." styleClass="auth-caption" wrapText="true"/>
      <Region prefHeight="12"/>
      <Label text="PRIVATE CHATS     /     GROUPS     /     SMART ASSISTANT" styleClass="pill"/>
      <Region prefHeight="58"/>
      <Label text="Beautifully simple. Thoughtfully connected." styleClass="muted"/>
    </VBox>
  </left>
  <center>
    <VBox spacing="12" styleClass="auth-panel" prefWidth="630">
      <Label text="RELAY ACCOUNT" styleClass="sidebar-heading"/>
      <Region prefHeight="4"/>
      <Label text="Set a new password" styleClass="auth-title"/>
      <Label text="Choose a strong password you have not used before." fx:id="feedbackLabel" styleClass="auth-subtitle" wrapText="true"/>
      <Region prefHeight="12"/>
      <VBox spacing="7">
        <Label text="New password" styleClass="form-label"/>
        <PasswordField fx:id="passwordField" onAction="#submit" promptText="Enter new password" prefWidth="386"/>
      </VBox>
      <VBox spacing="7">
        <Label text="Confirm new password" styleClass="form-label"/>
        <PasswordField fx:id="confirmPasswordField" onAction="#submit" promptText="Re-enter new password" prefWidth="386"/>
      </VBox>
      <VBox spacing="12" styleClass="card-flat">
        <Label text="Password requirements" styleClass="small-heading"/>
        <Label text="At least 8 characters · One number · One special character" styleClass="muted"/>
      </VBox>
      <Button fx:id="submitButton" onAction="#submit" text="Reset password  →" styleClass="primary-button" prefWidth="386"/>
      <Region prefHeight="5"/>
      <Button fx:id="backButton" onAction="#back" text="←  Return to sign in" styleClass="inline-link"/>
    </VBox>
  </center>
</BorderPane>
