<?xml version="1.0" encoding="UTF-8"?><?import javafx.scene.layout.*?><?import javafx.scene.control.*?>
<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.chatsystem.admin.controller.GroupsController" spacing="20" styleClass="content-area">
 <Label text="Groups" styleClass="page-title"/><Label text="Inspect communities and their membership" styleClass="muted-text"/><HBox spacing="12"><TextField fx:id="searchField" promptText="Search group name or owner" styleClass="search-field" HBox.hgrow="ALWAYS"/><MenuButton fx:id="sortButton" text="Sort: member count  v" styleClass="secondary-button"/></HBox><HBox styleClass="card" spacing="60"><Label text="Group"/><Label text="Owner / created"/><Label text="Members"/><Label text="Action"/></HBox><Label fx:id="emptyLabel" text="No groups match this search." styleClass="muted-text" visible="false" managed="false"/><ListView fx:id="groupList" VBox.vgrow="ALWAYS"/>
