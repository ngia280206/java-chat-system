<?xml version="1.0" encoding="UTF-8"?><?import javafx.scene.layout.*?><?import javafx.scene.control.*?>
<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.chatsystem.admin.controller.DashboardController" spacing="24" styleClass="content-area">
 <HBox alignment="CENTER_LEFT" spacing="16"><VBox><Label text="Platform overview" styleClass="page-title"/><Label text="Monitor members, groups, messages, and warnings" styleClass="muted-text"/></VBox><Region HBox.hgrow="ALWAYS"/><StackPane fx:id="exportWrapper"><Button fx:id="exportButton" text="Export overview" styleClass="secondary-button"/></StackPane></HBox>
 <HBox spacing="16"><VBox styleClass="card"><Label text="Members"/><Label fx:id="usersMetric" styleClass="metric-value"/></VBox><VBox styleClass="card"><Label text="Groups"/><Label fx:id="groupsMetric" styleClass="metric-value"/></VBox><VBox styleClass="card"><Label text="Pending warnings"/><Label fx:id="reportsMetric" styleClass="metric-value"/></VBox><VBox styleClass="card"><Label text="Messages"/><Label fx:id="messagesMetric" styleClass="metric-value"/></VBox></HBox>
 <HBox spacing="12"><Button fx:id="rangeButton" text="Last 30 days  v" styleClass="small-button"/><Button fx:id="viewUsersButton" text="View all people" styleClass="small-button"/><Button fx:id="viewGroupsButton" text="View all groups" styleClass="small-button"/><Button fx:id="viewModerationButton" text="View warnings" styleClass="small-button"/></HBox>
 <VBox styleClass="card" VBox.vgrow="ALWAYS"><Label text="Weekly platform activity" styleClass="section-title"/><Label text="The selected date range updates the live metrics and activity projection." styleClass="muted-text"/></VBox>
</VBox>
