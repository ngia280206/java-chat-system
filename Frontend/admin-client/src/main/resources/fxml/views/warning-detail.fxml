<?xml version="1.0" encoding="UTF-8"?><?import javafx.scene.layout.*?><?import javafx.scene.control.*?>
<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.chatsystem.admin.controller.WarningDetailController" spacing="18" styleClass="content-area">
 <HBox alignment="CENTER_LEFT"><VBox><Label text="Warning details" styleClass="page-title"/><Label text="Inspect evidence and record a moderation decision." styleClass="muted-text"/></VBox><Region HBox.hgrow="ALWAYS"/><Button fx:id="backButton" text="Back to warning queue" styleClass="secondary-button"/></HBox>
 <HBox spacing="16" VBox.vgrow="ALWAYS"><VBox spacing="12" styleClass="card" HBox.hgrow="ALWAYS"><Label text="Reported message" styleClass="section-title"/><Label fx:id="caseLabel" styleClass="sidebar-heading"/><VBox spacing="8" styleClass="card-flat"><Label fx:id="reportedUserLabel" styleClass="small-heading"/><Label fx:id="messageLabel" wrapText="true" styleClass="body-text"/></VBox><Separator/><HBox><Label text="Reported by" styleClass="muted-text"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="reporterLabel"/></HBox><HBox><Label text="Category" styleClass="muted-text"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="reasonLabel" wrapText="true"/></HBox></VBox>
 <VBox spacing="12" styleClass="card" HBox.hgrow="ALWAYS"><Label text="Review &amp; decision" styleClass="section-title"/><Label text="Current status" styleClass="form-label"/><Label fx:id="statusLabel" styleClass="status-pill"/><Label text="Moderation note" styleClass="form-label"/><TextArea fx:id="notesArea" promptText="Document what you reviewed and why you made this decision." prefRowCount="5"/><Label fx:id="validationLabel" wrapText="true" styleClass="muted-text"/><HBox spacing="10"><Button fx:id="dismissButton" text="Dismiss report" styleClass="secondary-button"/><Button fx:id="warnButton" text="Warn user" styleClass="primary-button"/><Button fx:id="suspendButton" text="Suspend user" styleClass="danger-button"/></HBox></VBox></HBox>
</VBox>
