<?xml version="1.0" encoding="UTF-8"?><?import javafx.scene.layout.*?><?import javafx.scene.control.*?>
<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.chatsystem.admin.controller.UsersController" spacing="20" styleClass="content-area">
 <HBox alignment="CENTER_LEFT"><VBox><Label text="People" styleClass="page-title"/><Label text="Search and manage member access" styleClass="muted-text"/></VBox><Region HBox.hgrow="ALWAYS"/><StackPane fx:id="downloadWrapper"><Button fx:id="downloadButton" text="Download CSV" styleClass="secondary-button"/></StackPane></HBox>
 <HBox spacing="12"><TextField fx:id="searchField" promptText="Search users by name, email, or ID" styleClass="search-field" HBox.hgrow="ALWAYS"/><MenuButton fx:id="sortButton" text="Sort: recent login  v" styleClass="secondary-button"/><MenuButton fx:id="filterButton" text="All statuses" styleClass="secondary-button"/></HBox>
 <HBox styleClass="card" spacing="40"><Label text="ID"/><Label text="Member / email"/><Label text="Account status"/><Label text="Action"/></HBox><Label fx:id="emptyLabel" text="No people match the current search and filters." styleClass="muted-text" visible="false" managed="false"/><ListView fx:id="userList" VBox.vgrow="ALWAYS"/><HBox spacing="12" alignment="CENTER_RIGHT"><Button fx:id="previousButton" text="Previous" styleClass="small-button"/><Button fx:id="nextButton" text="Next" styleClass="small-button"/></HBox>
</VBox>
