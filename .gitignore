# Gradle cache and generated build output
.gradle/
**/build/
!**/src/**/build/

# Java bytecode generated by direct compilation
*.class

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (.jar files are usually ignored)
!gradle-wrapper.jar

# Avoid ignore Gradle wrapper properties
!gradle-wrapper.properties

# Cache of project
.gradletasknamecache

# Local Git worktrees
.worktrees/

# Eclipse Gradle plugin generated files
# Eclipse Core
.project
# JDT-specific (Eclipse Java Development Tools)
.classpath

/Frontend/**/bin/
