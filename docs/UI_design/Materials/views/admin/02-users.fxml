                <Label text="98 sign-ins" styleClass="body-text" prefWidth="120"/>
                <Label text="Active" styleClass="pill-success" prefWidth="112"/>
                <Label text="View details" styleClass="body-text" prefWidth="92"/>
              </HBox>
              <HBox spacing="6" alignment="CENTER_LEFT" styleClass="table-row">
                <Label text="Jordan Lee" styleClass="small-heading" prefWidth="138"/>
                <Label text="jordan.lee@example.com" styleClass="body-text" prefWidth="221"/>
                <Label text="Yesterday, 22:05" styleClass="body-text" prefWidth="165"/>
                <Label text="74 sign-ins" styleClass="body-text" prefWidth="120"/>
                <Label text="Active" styleClass="pill-success" prefWidth="112"/>
                <Label text="View details" styleClass="body-text" prefWidth="92"/>
              </HBox>
              <HBox spacing="6" alignment="CENTER_LEFT" styleClass="table-row-alt">
