                <Label text="Inactive" styleClass="pill" prefWidth="112"/>
                <Label text="View details" styleClass="body-text" prefWidth="92"/>
              </HBox>
            </VBox>
            <HBox spacing="12" alignment="CENTER_LEFT">
              <Label text="Showing 6 of 8,426 users" styleClass="tiny-muted" HBox.hgrow="ALWAYS"/>
              <Button text="Previous" styleClass="small-button"/>
              <Label text="Page 1 of 85" styleClass="pill"/>
              <Button text="Next" styleClass="small-button"/>
