          <HBox spacing="15" alignment="CENTER_LEFT">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
              <Label text="Overview &amp; statistics" styleClass="page-title"/>
              <Label text="Monitor engagement, safety, and system activity." styleClass="page-subtitle"/>
            </VBox>
            <Button text="Export overview" styleClass="secondary-button"/>
          </HBox>
          <HBox spacing="14" alignment="CENTER_LEFT">
            <VBox spacing="12" styleClass="metric-card" minWidth="170" HBox.hgrow="ALWAYS">
              <Label text="Total users" styleClass="metric-label"/>
              <Label text="8,426" styleClass="value-large"/>
              <Label text="+12.6% vs last month" styleClass="metric-trend"/>
