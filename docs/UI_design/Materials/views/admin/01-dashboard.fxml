                <VBox spacing="12" alignment="BOTTOM_CENTER">
                  <Region prefHeight="90.625" prefWidth="26" styleClass="chart-bar-dim"/>
                </VBox>
                <VBox spacing="12" alignment="BOTTOM_CENTER">
                  <Region prefHeight="78.125" prefWidth="26" styleClass="chart-bar-dim"/>
                </VBox>
                <VBox spacing="12" alignment="BOTTOM_CENTER">
                  <Region prefHeight="107.5" prefWidth="26" styleClass="chart-bar-dim"/>
                </VBox>
                <VBox spacing="12" alignment="BOTTOM_CENTER">
                  <Region prefHeight="85.625" prefWidth="26" styleClass="chart-bar-dim"/>
                </VBox>
                <VBox spacing="12" alignment="BOTTOM_CENTER">
                  <Region prefHeight="98.75" prefWidth="26" styleClass="chart-bar-blue"/>
                </VBox>
                <VBox spacing="12" alignment="BOTTOM_CENTER">
                  <Region prefHeight="120.0" prefWidth="26" styleClass="chart-bar-dim"/>
                </VBox>
                <VBox spacing="12" alignment="BOTTOM_CENTER">
                  <Region prefHeight="105.0" prefWidth="26" styleClass="chart-bar-dim"/>
                </VBox>
                <VBox spacing="12" alignment="BOTTOM_CENTER">
                  <Region prefHeight="127.5" prefWidth="26" styleClass="chart-bar-blue"/>
                </VBox>
                <VBox spacing="12" alignment="BOTTOM_CENTER">
                  <Region prefHeight="117.5" prefWidth="26" styleClass="chart-bar-teal"/>
                </VBox>
              </HBox>
              <Separator/>
              <HBox spacing="40" alignment="CENTER_LEFT">
