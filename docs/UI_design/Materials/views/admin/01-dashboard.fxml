                <Label text="Wed" styleClass="tiny-muted" minWidth="36"/>
                <Label text="Thu" styleClass="tiny-muted" minWidth="36"/>
                <Label text="Fri" styleClass="tiny-muted" minWidth="36"/>
                <Label text="Sat" styleClass="tiny-muted" minWidth="36"/>
