<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>
<?import java.lang.String?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" styleClass="app-root" prefWidth="1480" prefHeight="920" stylesheets="@../../styles/dark.css">
  <left>
    <VBox spacing="12" styleClass="sidebar" prefWidth="240" minWidth="240" maxWidth="240">
      <HBox spacing="11" alignment="CENTER_LEFT">
        <StackPane styleClass="brand-badge">
          <Label text="R" styleClass="brand-mark"/>
        </StackPane>
        <VBox spacing="1">
          <Label text="RELAY" styleClass="brand-name"/>
          <Label text="MESSENGER" styleClass="brand-subtitle"/>
        </VBox>
      </HBox>
      <Region prefHeight="23"/>
      <Label text="YOUR SPACE" styleClass="sidebar-heading"/>
      <Button text="  Chats" styleClass="nav-active" maxWidth="230" prefWidth="206"/>
      <Button text="  Friends" styleClass="nav-button" maxWidth="230" prefWidth="206"/>
      <Button text="  Groups" styleClass="nav-button" maxWidth="230" prefWidth="206"/>
      <Button text="  Spam reports" styleClass="nav-button" maxWidth="230" prefWidth="206"/>
      <Button text="  My profile" styleClass="nav-button" maxWidth="230" prefWidth="206"/>
      <Region prefHeight="15"/>
      <Label text="ACCOUNT" styleClass="sidebar-heading"/>
      <Button text="  Settings" styleClass="nav-button" prefWidth="206"/>
      <Button text="  Help &amp; support" styleClass="nav-button" prefWidth="206"/>
      <Region minHeight="15" VBox.vgrow="ALWAYS"/>
      <VBox spacing="12" styleClass="sidebar-footer">
        <HBox spacing="12" alignment="CENTER_LEFT">
          <StackPane styleClass="avatar">
            <Label text="ME" styleClass="avatar-label"/>
          </StackPane>
          <VBox spacing="4">
            <Label text="Alex Morgan" styleClass="small-heading"/>
            <Label text="Online now" styleClass="tiny-muted"/>
          </VBox>
        </HBox>
      </VBox>
    </VBox>
  </left>
  <center>
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="content-scroll">
      <content>
        <VBox spacing="12" styleClass="content-wrap">
          <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="RELAY  /  CHATS" styleClass="breadcrumb" HBox.hgrow="ALWAYS"/>
            <Label text="PREVIEW ONLY" styleClass="pill"/>
            <Label text="Nov 2026" styleClass="muted"/>
          </HBox>
          <HBox spacing="15" alignment="CENTER_LEFT">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
              <Label text="Search messages" styleClass="page-title"/>
              <Label text="Find messages and jump to their conversation." styleClass="page-subtitle"/>
            </VBox>
            <Button text="Back to chats" styleClass="secondary-button"/>
          </HBox>
          <VBox spacing="12" styleClass="card">
            <Label text="Search within messages" styleClass="section-title"/>
            <HBox spacing="12" alignment="CENTER_LEFT">
              <TextField promptText="mockup" styleClass="search-field" HBox.hgrow="ALWAYS"/>
              <Button text="All conversations  v" styleClass="secondary-button"/>
              <Button text="Search" styleClass="primary-button"/>
            </HBox>
            <HBox spacing="12" alignment="CENTER_LEFT">
              <Label text="All dates" styleClass="pill-active"/>
              <Label text="Images" styleClass="pill"/>
              <Label text="Links" styleClass="pill"/>
              <Label text="Files" styleClass="pill"/>
            </HBox>
          </VBox>
          <VBox spacing="12" styleClass="card">
            <HBox spacing="12" alignment="CENTER_LEFT">
              <Label text="Results in conversation" styleClass="section-title" HBox.hgrow="ALWAYS"/>
              <Label text="4 matches" styleClass="pill"/>
            </HBox>
            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="list-item">
              <StackPane styleClass="avatar-violet">
                <Label text="MT" styleClass="avatar-label"/>
              </StackPane>
              <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Mia Tran" styleClass="list-title"/>
                <Label text="“The latest mockup is ready to review.”" styleClass="list-preview"/>
              </VBox>
              <VBox spacing="4" alignment="CENTER_RIGHT">
                <Label text="Nov 09" styleClass="tiny-muted"/>
              </VBox>
            </HBox>
            <Separator/>
            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="list-item">
              <StackPane styleClass="avatar">
                <Label text="ME" styleClass="avatar-label"/>
              </StackPane>
              <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="You" styleClass="list-title"/>
                <Label text="“I will send the final mockup tonight.”" styleClass="list-preview"/>
              </VBox>
              <VBox spacing="4" alignment="CENTER_RIGHT">
                <Label text="Nov 07" styleClass="tiny-muted"/>
              </VBox>
            </HBox>
            <Separator/>
            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="list-item">
              <StackPane styleClass="avatar-violet">
                <Label text="MT" styleClass="avatar-label"/>
              </StackPane>
              <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Mia Tran" styleClass="list-title"/>
                <Label text="“Can we update the login screen mockup?”" styleClass="list-preview"/>
              </VBox>
              <VBox spacing="4" alignment="CENTER_RIGHT">
                <Label text="Nov 05" styleClass="tiny-muted"/>
              </VBox>
            </HBox>
            <Separator/>
            <HBox spacing="10" alignment="CENTER_LEFT" styleClass="list-item">
              <StackPane styleClass="avatar">
                <Label text="ME" styleClass="avatar-label"/>
              </StackPane>
              <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="You" styleClass="list-title"/>
                <Label text="“The first mockup had a smaller sidebar.”" styleClass="list-preview"/>
              </VBox>
              <VBox spacing="4" alignment="CENTER_RIGHT">
                <Label text="Oct 29" styleClass="tiny-muted"/>
              </VBox>
            </HBox>
          </VBox>
        </VBox>
      </content>
    </ScrollPane>
  </center>
</BorderPane>
