<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>
<?import java.lang.String?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" styleClass="app-root" prefWidth="1480" prefHeight="920" stylesheets="@../../styles/dark.css">
  <left>
    <VBox spacing="12" styleClass="sidebar" prefWidth="240" minWidth="240" maxWidth="240">
      <HBox spacing="11" alignment="CENTER_LEFT">
        <StackPane styleClass="brand-badge">
          <Label text="R" styleClass="brand-mark"/>
        </StackPane>
        <VBox spacing="1">
          <Label text="RELAY" styleClass="brand-name"/>
          <Label text="MESSENGER" styleClass="brand-subtitle"/>
        </VBox>
      </HBox>
      <Region prefHeight="23"/>
      <Label text="YOUR SPACE" styleClass="sidebar-heading"/>
      <Button text="  Chats" styleClass="nav-button" maxWidth="230" prefWidth="206"/>
      <Button text="  Friends" styleClass="nav-active" maxWidth="230" prefWidth="206"/>
      <Button text="  Groups" styleClass="nav-button" maxWidth="230" prefWidth="206"/>
      <Button text="  Spam reports" styleClass="nav-button" maxWidth="230" prefWidth="206"/>
      <Button text="  My profile" styleClass="nav-button" maxWidth="230" prefWidth="206"/>
      <Region prefHeight="15"/>
      <Label text="ACCOUNT" styleClass="sidebar-heading"/>
      <Button text="  Settings" styleClass="nav-button" prefWidth="206"/>
      <Button text="  Help &amp; support" styleClass="nav-button" prefWidth="206"/>
      <Region minHeight="15" VBox.vgrow="ALWAYS"/>
      <VBox spacing="12" styleClass="sidebar-footer">
        <HBox spacing="12" alignment="CENTER_LEFT">
          <StackPane styleClass="avatar">
            <Label text="ME" styleClass="avatar-label"/>
          </StackPane>
          <VBox spacing="4">
            <Label text="Alex Morgan" styleClass="small-heading"/>
            <Label text="Online now" styleClass="tiny-muted"/>
          </VBox>
        </HBox>
      </VBox>
    </VBox>
  </left>
  <center>
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="content-scroll">
      <content>
        <VBox spacing="12" styleClass="content-wrap">
          <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="RELAY  /  FRIENDS" styleClass="breadcrumb" HBox.hgrow="ALWAYS"/>
            <Label text="PREVIEW ONLY" styleClass="pill"/>
            <Label text="Nov 2026" styleClass="muted"/>
          </HBox>
          <HBox spacing="15" alignment="CENTER_LEFT">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
              <Label text="Friends" styleClass="page-title"/>
              <Label text="Stay connected and manage your network." styleClass="page-subtitle"/>
            </VBox>
            <Button text="+ Add friend" styleClass="primary-button"/>
          </HBox>
          <HBox spacing="14" alignment="CENTER_LEFT">
            <VBox spacing="12" styleClass="metric-card" minWidth="170" HBox.hgrow="ALWAYS">
              <Label text="Total friends" styleClass="metric-label"/>
              <Label text="86" styleClass="value-large"/>
              <Label text="5 added this month" styleClass="metric-trend"/>
            </VBox>
            <VBox spacing="12" styleClass="metric-card" minWidth="170" HBox.hgrow="ALWAYS">
              <Label text="Online now" styleClass="metric-label"/>
              <Label text="23" styleClass="value-large"/>
              <Label text="Friends available" styleClass="metric-trend"/>
            </VBox>
            <VBox spacing="12" styleClass="metric-card" minWidth="170" HBox.hgrow="ALWAYS">
              <Label text="Pending requests" styleClass="metric-label"/>
              <Label text="4" styleClass="value-large"/>
              <Label text="Awaiting your response" styleClass="metric-trend-warn"/>
            </VBox>
          </HBox>
          <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="All friends" styleClass="pill-active"/>
            <Label text="Requests" styleClass="pill"/>
            <Label text="Blocked" styleClass="pill"/>
          </HBox>
          <VBox spacing="12" styleClass="card">
            <HBox spacing="12" alignment="CENTER_LEFT">
              <Label text="Your friends" styleClass="section-title" HBox.hgrow="ALWAYS"/>
              <Label text="86 friends" styleClass="pill"/>
            </HBox>
            <HBox spacing="12" alignment="CENTER_LEFT">
              <TextField promptText="Search by name or username" styleClass="search-field" HBox.hgrow="ALWAYS"/>
              <Button text="Online first  v" styleClass="secondary-button"/>
            </HBox>
            <VBox spacing="1">
              <HBox spacing="6" alignment="CENTER_LEFT">
                <Label text="FRIEND" styleClass="table-heading" prefWidth="245"/>
                <Label text="USERNAME" styleClass="table-heading" prefWidth="220"/>
                <Label text="STATUS" styleClass="table-heading" prefWidth="160"/>
                <Label text="ACTIONS" styleClass="table-heading" prefWidth="142"/>
              </HBox>
              <Separator/>
              <HBox spacing="6" alignment="CENTER_LEFT" styleClass="table-row">
                <Label text="Mia Tran" styleClass="small-heading" prefWidth="245"/>
                <Label text="@miatran" styleClass="body-text" prefWidth="220"/>
                <Label text="Online" styleClass="pill-success" prefWidth="160"/>
                <Button text="Message" styleClass="small-button" prefWidth="142"/>
              </HBox>
              <HBox spacing="6" alignment="CENTER_LEFT" styleClass="table-row-alt">
                <Label text="Jordan Lee" styleClass="small-heading" prefWidth="245"/>
                <Label text="@jordanlee" styleClass="body-text" prefWidth="220"/>
                <Label text="Online" styleClass="pill-success" prefWidth="160"/>
                <Button text="Message" styleClass="small-button" prefWidth="142"/>
              </HBox>
              <HBox spacing="6" alignment="CENTER_LEFT" styleClass="table-row">
                <Label text="Sam Rivera" styleClass="small-heading" prefWidth="245"/>
                <Label text="@samrivera" styleClass="body-text" prefWidth="220"/>
                <Label text="Away" styleClass="pill-warning" prefWidth="160"/>
                <Button text="Message" styleClass="small-button" prefWidth="142"/>
              </HBox>
              <HBox spacing="6" alignment="CENTER_LEFT" styleClass="table-row-alt">
                <Label text="Casey Brown" styleClass="small-heading" prefWidth="245"/>
                <Label text="@caseybrown" styleClass="body-text" prefWidth="220"/>
                <Label text="Offline" styleClass="pill" prefWidth="160"/>
                <Button text="Message" styleClass="small-button" prefWidth="142"/>
              </HBox>
            </VBox>
          </VBox>
        </VBox>
      </content>
    </ScrollPane>
  </center>
</BorderPane>
