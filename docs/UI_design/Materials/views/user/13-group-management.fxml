<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>
<?import java.lang.String?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" styleClass="app-root" prefWidth="1480" prefHeight="920" stylesheets="@../../styles/dark.css">
  <left>
    <VBox spacing="12" styleClass="sidebar" prefWidth="240" minWidth="240" maxWidth="240">
      <HBox spacing="11" alignment="CENTER_LEFT">
        <StackPane styleClass="brand-badge">
          <Label text="R" styleClass="brand-mark"/>
        </StackPane>
        <VBox spacing="1">
          <Label text="RELAY" styleClass="brand-name"/>
          <Label text="MESSENGER" styleClass="brand-subtitle"/>
        </VBox>
      </HBox>
      <Region prefHeight="23"/>
      <Label text="YOUR SPACE" styleClass="sidebar-heading"/>
      <Button text="  Chats" styleClass="nav-button" maxWidth="230" prefWidth="206"/>
      <Button text="  Friends" styleClass="nav-button" maxWidth="230" prefWidth="206"/>
      <Button text="  Groups" styleClass="nav-active" maxWidth="230" prefWidth="206"/>
      <Button text="  Spam reports" styleClass="nav-button" maxWidth="230" prefWidth="206"/>
      <Button text="  My profile" styleClass="nav-button" maxWidth="230" prefWidth="206"/>
      <Region prefHeight="15"/>
      <Label text="ACCOUNT" styleClass="sidebar-heading"/>
      <Button text="  Settings" styleClass="nav-button" prefWidth="206"/>
      <Button text="  Help &amp; support" styleClass="nav-button" prefWidth="206"/>
      <Region minHeight="15" VBox.vgrow="ALWAYS"/>
      <VBox spacing="12" styleClass="sidebar-footer">
        <HBox spacing="12" alignment="CENTER_LEFT">
          <StackPane styleClass="avatar">
            <Label text="ME" styleClass="avatar-label"/>
          </StackPane>
          <VBox spacing="4">
            <Label text="Alex Morgan" styleClass="small-heading"/>
            <Label text="Online now" styleClass="tiny-muted"/>
          </VBox>
        </HBox>
      </VBox>
    </VBox>
  </left>
  <center>
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" styleClass="content-scroll">
      <content>
        <VBox spacing="12" styleClass="content-wrap">
          <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="RELAY  /  GROUPS" styleClass="breadcrumb" HBox.hgrow="ALWAYS"/>
            <Label text="PREVIEW ONLY" styleClass="pill"/>
            <Label text="Nov 2026" styleClass="muted"/>
          </HBox>
          <HBox spacing="15" alignment="CENTER_LEFT">
            <VBox spacing="5" HBox.hgrow="ALWAYS">
              <Label text="Group management" styleClass="page-title"/>
              <Label text="View groups, invitations, and member administration." styleClass="page-subtitle"/>
            </VBox>
            <Button text="+ Create group" styleClass="primary-button"/>
          </HBox>
          <HBox spacing="14" alignment="CENTER_LEFT">
            <VBox spacing="12" styleClass="metric-card" minWidth="170" HBox.hgrow="ALWAYS">
              <Label text="My groups" styleClass="metric-label"/>
              <Label text="10" styleClass="value-large"/>
              <Label text="1 owned · 2 moderated" styleClass="metric-trend"/>
            </VBox>
            <VBox spacing="12" styleClass="metric-card" minWidth="170" HBox.hgrow="ALWAYS">
              <Label text="Invitations" styleClass="metric-label"/>
              <Label text="3" styleClass="value-large"/>
              <Label text="Waiting for your response" styleClass="metric-trend-warn"/>
            </VBox>
            <VBox spacing="12" styleClass="metric-card" minWidth="170" HBox.hgrow="ALWAYS">
              <Label text="Total members" styleClass="metric-label"/>
              <Label text="426" styleClass="value-large"/>
              <Label text="Across all groups" styleClass="metric-trend"/>
            </VBox>
          </HBox>
          <HBox spacing="16" alignment="CENTER_LEFT">
            <VBox spacing="12" styleClass="card" HBox.hgrow="ALWAYS">
              <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="My groups" styleClass="section-title" HBox.hgrow="ALWAYS"/>
                <Button text="View all" styleClass="small-button"/>
              </HBox>
              <HBox spacing="10" alignment="CENTER_LEFT" styleClass="list-item">
                <StackPane styleClass="avatar-teal">
                  <Label text="DC" styleClass="avatar-label"/>
                </StackPane>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                  <Label text="Design Circle" styleClass="list-title"/>
                  <Label text="36 members · 12 online" styleClass="list-preview"/>
                </VBox>
                <VBox spacing="4" alignment="CENTER_RIGHT">
                  <Label text="5 unread" styleClass="tiny-muted"/>
                </VBox>
              </HBox>
              <Separator/>
              <HBox spacing="10" alignment="CENTER_LEFT" styleClass="list-item">
                <StackPane styleClass="avatar-violet">
                  <Label text="SH" styleClass="avatar-label"/>
                </StackPane>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                  <Label text="Study Hub" styleClass="list-title"/>
                  <Label text="128 members · 20 online" styleClass="list-preview"/>
                </VBox>
                <VBox spacing="4" alignment="CENTER_RIGHT">
                  <Label text="1 unread" styleClass="tiny-muted"/>
                </VBox>
              </HBox>
              <Separator/>
              <HBox spacing="10" alignment="CENTER_LEFT" styleClass="list-item">
                <StackPane styleClass="avatar-rose">
                  <Label text="WC" styleClass="avatar-label"/>
                </StackPane>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                  <Label text="Weekend Crew" styleClass="list-title"/>
                  <Label text="18 members · 6 online" styleClass="list-preview"/>
                </VBox>
                <VBox spacing="4" alignment="CENTER_RIGHT"/>
              </HBox>
              <Separator/>
              <HBox spacing="10" alignment="CENTER_LEFT" styleClass="list-item">
                <StackPane styleClass="avatar">
                  <Label text="DV" styleClass="avatar-label"/>
                </StackPane>
                <VBox spacing="4" HBox.hgrow="ALWAYS">
                  <Label text="Dev Community" styleClass="list-title"/>
                  <Label text="243 members · 48 online" styleClass="list-preview"/>
                </VBox>
                <VBox spacing="4" alignment="CENTER_RIGHT"/>
              </HBox>
            </VBox>
            <VBox spacing="12" styleClass="card" HBox.hgrow="ALWAYS">
              <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Group tools" styleClass="section-title" HBox.hgrow="ALWAYS"/>
              </HBox>
              <Label text="Keep your communities organized in one place." styleClass="muted"/>
              <HBox spacing="12" alignment="CENTER_LEFT">
                <Button text="Group invitations" styleClass="secondary-button"/>
                <Button text="Manage members" styleClass="secondary-button"/>
              </HBox>
              <VBox spacing="12" styleClass="card-flat">
                <Label text="Your roles" styleClass="small-heading"/>
                <HBox spacing="12" alignment="CENTER_LEFT">
                  <Label text="Owned groups" styleClass="muted" HBox.hgrow="ALWAYS"/>
                  <Label text="1" styleClass="body-text"/>
                </HBox>
                <HBox spacing="12" alignment="CENTER_LEFT">
                  <Label text="Moderated groups" styleClass="muted" HBox.hgrow="ALWAYS"/>
                  <Label text="2" styleClass="body-text"/>
                </HBox>
                <HBox spacing="12" alignment="CENTER_LEFT">
                  <Label text="Member groups" styleClass="muted" HBox.hgrow="ALWAYS"/>
                  <Label text="7" styleClass="body-text"/>
                </HBox>
              </VBox>
            </VBox>
          </HBox>
        </VBox>
      </content>
    </ScrollPane>
  </center>
</BorderPane>
