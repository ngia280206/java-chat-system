<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>
<?import java.lang.String?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" styleClass="app-root" prefWidth="1540" prefHeight="930" stylesheets="@../../styles/dark.css">
  <left>
    <VBox spacing="12" styleClass="sidebar" prefWidth="240" minWidth="240" maxWidth="240">
      <HBox spacing="11" alignment="CENTER_LEFT">
        <StackPane styleClass="brand-badge">
          <Label text="R" styleClass="brand-mark"/>
        </StackPane>
        <VBox spacing="1">
          <Label text="RELAY" styleClass="brand-name"/>
          <Label text="MESSENGER" styleClass="brand-subtitle"/>
        </VBox>
      </HBox>
      <Region prefHeight="23"/>
      <Label text="YOUR SPACE" styleClass="sidebar-heading"/>
      <Button text="  Chats" styleClass="nav-active" maxWidth="230" prefWidth="206"/>
      <Button text="  Friends" styleClass="nav-button" maxWidth="230" prefWidth="206"/>
      <Button text="  Groups" styleClass="nav-button" maxWidth="230" prefWidth="206"/>
      <Button text="  Spam reports" styleClass="nav-button" maxWidth="230" prefWidth="206"/>
      <Button text="  My profile" styleClass="nav-button" maxWidth="230" prefWidth="206"/>
      <Region prefHeight="15"/>
      <Label text="ACCOUNT" styleClass="sidebar-heading"/>
      <Button text="  Settings" styleClass="nav-button" prefWidth="206"/>
      <Button text="  Help &amp; support" styleClass="nav-button" prefWidth="206"/>
      <Region minHeight="15" VBox.vgrow="ALWAYS"/>
      <VBox spacing="12" styleClass="sidebar-footer">
        <HBox spacing="12" alignment="CENTER_LEFT">
          <StackPane styleClass="avatar">
            <Label text="ME" styleClass="avatar-label"/>
          </StackPane>
          <VBox spacing="4">
            <Label text="Alex Morgan" styleClass="small-heading"/>
            <Label text="Online now" styleClass="tiny-muted"/>
          </VBox>
        </HBox>
      </VBox>
    </VBox>
  </left>
  <center>
    <HBox spacing="0" alignment="CENTER_LEFT">
      <VBox spacing="12" styleClass="conversation-pane" prefWidth="330" minWidth="300" maxWidth="330">
        <HBox spacing="12" alignment="CENTER_LEFT">
          <Label text="Messages" styleClass="section-title" HBox.hgrow="ALWAYS"/>
          <Button text="+ New" styleClass="small-button"/>
        </HBox>
        <TextField promptText="Search conversations" styleClass="search-field"/>
        <HBox spacing="12" alignment="CENTER_LEFT">
          <Label text="All" styleClass="pill-active"/>
          <Label text="Unread" styleClass="pill"/>
          <Label text="Groups" styleClass="pill"/>
        </HBox>
        <Region prefHeight="4"/>
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="list-item">
          <StackPane styleClass="avatar-violet">
            <Label text="MT" styleClass="avatar-label"/>
          </StackPane>
          <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Mia Tran" styleClass="list-title"/>
            <Label text="Can you review the latest mockup?" styleClass="list-preview"/>
          </VBox>
          <VBox spacing="4" alignment="CENTER_RIGHT">
            <Label text="10:42" styleClass="tiny-muted"/>
            <Label text="2" styleClass="pill-active"/>
          </VBox>
        </HBox>
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="list-item">
          <StackPane styleClass="avatar-teal">
            <Label text="DC" styleClass="avatar-label"/>
          </StackPane>
          <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Design Circle" styleClass="list-title"/>
            <Label text="Jordan: I shared the new files" styleClass="list-preview"/>
          </VBox>
          <VBox spacing="4" alignment="CENTER_RIGHT">
            <Label text="09:28" styleClass="tiny-muted"/>
            <Label text="5" styleClass="pill-active"/>
          </VBox>
        </HBox>
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="list-item">
          <StackPane styleClass="avatar">
            <Label text="JL" styleClass="avatar-label"/>
          </StackPane>
          <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Jordan Lee" styleClass="list-title"/>
            <Label text="Thanks for your help yesterday!" styleClass="list-preview"/>
          </VBox>
          <VBox spacing="4" alignment="CENTER_RIGHT">
            <Label text="Yesterday" styleClass="tiny-muted"/>
          </VBox>
        </HBox>
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="list-item">
          <StackPane styleClass="avatar-rose">
            <Label text="SH" styleClass="avatar-label"/>
          </StackPane>
          <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Study Hub" styleClass="list-title"/>
            <Label text="Tomorrow at 8 PM works for me" styleClass="list-preview"/>
          </VBox>
          <VBox spacing="4" alignment="CENTER_RIGHT">
            <Label text="Yesterday" styleClass="tiny-muted"/>
            <Label text="1" styleClass="pill-active"/>
          </VBox>
        </HBox>
        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="list-item">
          <StackPane styleClass="avatar-teal">
            <Label text="SR" styleClass="avatar-label"/>
          </StackPane>
          <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Sam Rivera" styleClass="list-title"/>
            <Label text="Sounds good, see you there" styleClass="list-preview"/>
          </VBox>
          <VBox spacing="4" alignment="CENTER_RIGHT">
            <Label text="Mon" styleClass="tiny-muted"/>
          </VBox>
        </HBox>
        <Region VBox.vgrow="ALWAYS"/>
        <Label text="12 conversations  ·  8 unread" styleClass="tiny-muted"/>
      </VBox>
      <StackPane styleClass="chat-main" HBox.hgrow="ALWAYS">
        <VBox spacing="12" styleClass="empty-state" maxWidth="600">
          <StackPane styleClass="brand-badge">
            <Label text="R" styleClass="auth-accent"/>
          </StackPane>
          <Label text="Your conversations, all in one place" styleClass="page-title"/>
          <Label text="Choose a conversation to start chatting, or create a new one." styleClass="page-subtitle"/>
          <HBox spacing="12" alignment="CENTER_LEFT">
            <Button text="Start a conversation" styleClass="primary-button"/>
            <Button text="Explore groups" styleClass="secondary-button"/>
          </HBox>
          <Label text="Tip: Use Unread to focus on messages you have not seen." styleClass="tiny-muted"/>
        </VBox>
      </StackPane>
    </HBox>
  </center>
</BorderPane>
